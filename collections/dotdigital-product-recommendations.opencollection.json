{
  "opencollection": "1.0.0",
  "info": {
    "name": "Product recommendations",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Programs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all product recommendations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{region}-api.dotdigital.com/v2/products/recommendations",
            "headers": [
              {
                "name": "x-ddg-integration-token",
                "value": ""
              }
            ]
          },
          "docs": "Gets all product recommendations"
        }
      ]
    }
  ],
  "bundled": true
}